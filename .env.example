# ── Admin CMS (/admin) ─────────────────────────────────────────────────────
# Mot de passe d'accès à l'espace admin. À DÉFINIR en production.
# (Sans variable, un mot de passe de dev "behar-admin" est utilisé.)
ADMIN_PASSWORD="changez-moi"

# Secret de signature du cookie de session (chaîne aléatoire longue).
# Optionnel : par défaut dérivé de ADMIN_PASSWORD.
ADMIN_SECRET="une-chaine-aleatoire-tres-longue"

# ── Supabase Auth + Database ──────────────────────────────────────────────
# Récupérer ces valeurs dans Supabase > Project Settings > API.
PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="votre-cle-anon-publishable"

# Compatibilité avec les anciens helpers Vite du projet.
VITE_SUPABASE_URL="https://votre-projet.supabase.co"
VITE_SUPABASE_ANON_KEY="votre-cle-anon-publishable"
# Serveur uniquement : webhooks Stripe, portail de facturation et provisionnement.
SUPABASE_SERVICE_ROLE_KEY="votre-cle-service-role"

# ── SaaS (app.behartechpro.fr) ─────────────────────────────────────────────
# URL du SaaS Behar Tech Pro. Si définie, après une connexion réussie (une fois
# l'onboarding terminé), l'utilisateur est redirigé vers <APP_URL>/accueil
# (portail d'entrée du SaaS). Laisser vide conserve le comportement /client.
# Aucun token n'est transmis dans l'URL : le SaaS revérifie la session côté app.
PUBLIC_APP_URL="https://app.behartechpro.fr"
VITE_APP_URL="https://app.behartechpro.fr"

# ── Stripe (toutes les valeurs restent côté serveur) ───────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_YEARLY="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
STRIPE_PRICE_BUSINESS_MONTHLY="price_..."
STRIPE_PRICE_BUSINESS_YEARLY="price_..."

# ── E-mails transactionnels (Resend) ─────────────────────────────────────
# Sert aux e-mails de bienvenue, de licence et de confirmation d'abonnement.
# La confirmation de l'adresse e-mail reste envoyée par Supabase Auth via SMTP.
RESEND_API_KEY="re_..."
EMAIL_FROM="Behar Tech Pro <noreply@updates.behartechpro.fr>"
EMAIL_REPLY_TO="support@behartechpro.fr"

# ── PostHog ────────────────────────────────────────────────────────────────
PUBLIC_POSTHOG_PROJECT_TOKEN=""
PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
