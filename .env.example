CLICKSEND_USERNAME=replace_me
CLICKSEND_API_KEY=replace_me

# Netlify:
# Site settings > Environment variables
# Add the same two variables there. Never expose these keys in frontend code.

# ── Supabase — sync cloud (Option B : backup/restore manuel) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
# Service role — backend only, NE PAS commit
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Widget public — secrets backend uniquement (valeurs aléatoires distinctes, 32 octets minimum)
WIDGET_TOKEN_SECRET=replace_with_a_random_32_byte_secret
WIDGET_RATE_LIMIT_SECRET=replace_with_another_random_32_byte_secret

# URL publique absolue utilisée dans les QR/lien client
NEXT_PUBLIC_APP_URL=https://app.behartechpro.fr
NEXT_PUBLIC_SITE_URL=https://behartechpro.fr
NEXT_PUBLIC_WIDGET_SCRIPT_ORIGIN=https://behartechpro.fr
# Pour tester en local avec un téléphone sur le même Wi-Fi, mettez l'IP du PC et démarrez le serveur avec --host
VITE_PUBLIC_APP_URL=http://localhost:3000
# Compat ancienne config :
NEXT_PUBLIC_PUBLIC_BASE_URL=https://app.behartechpro.fr

# SSO site public <-> SaaS (serveur uniquement pour le secret)
NEXT_PUBLIC_MARKETING_URL=https://behartechpro.fr
APP_SESSION_SECRET=replace_with_a_random_32_byte_secret

# ── Demandes de paiement externes (serveur uniquement) ──
# Namespace distinct de la facturation des abonnements Behar Tech Pro.
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_REDIRECT_URI=

SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_REDIRECT_URI=
SUMUP_AFFILIATE_KEY=
SUMUP_ENVIRONMENT=sandbox
SUMUP_TERMINAL_DISPATCH_ENABLED=false

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_ID=
PAYPAL_BN_CODE=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_RETURN_URL=

SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URI=
SQUARE_ENVIRONMENT=sandbox

# Configuration globale uniquement. Les Secret API Keys des réparateurs sont
# saisies dans le SaaS et chiffrées en base, jamais placées dans Vercel.
# Revolut ne documente actuellement aucun identifiant partenaire global public.
REVOLUT_ENVIRONMENT=sandbox
REVOLUT_API_VERSION=2026-04-20

MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=
MOLLIE_REDIRECT_URI=
MOLLIE_ENVIRONMENT=test

# 32 octets exacts, encodes en base64 ou en 64 caracteres hexadecimaux.
PAYMENT_TOKEN_ENCRYPTION_KEY=
