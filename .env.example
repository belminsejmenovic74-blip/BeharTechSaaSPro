# ── Admin CMS (/admin) ─────────────────────────────────────────────────────
# Mot de passe d'accès à l'espace admin. À DÉFINIR en production.
# (Sans variable, un mot de passe de dev "behar-admin" est utilisé.)
ADMIN_PASSWORD="changez-moi"

# Secret de signature du cookie de session (chaîne aléatoire longue).
# Optionnel : par défaut dérivé de ADMIN_PASSWORD.
ADMIN_SECRET="une-chaine-aleatoire-tres-longue"
